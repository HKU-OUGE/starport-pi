{
  "name": "starport-pi",
  "version": "0.1.0",
  "private": true,
  "description": "Pi workbench with remote-only execution, managed egress and isolated server workspaces",
  "type": "module",
  "license": "MIT",
  "bin": {
    "starport-pi": "bin/starport-pi.mjs"
  },
  "scripts": {
    "start": "node bin/starport-pi.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:server": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "audit:source": "python3 scripts/audit_source.py"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "overrides": {
    "@earendil-works/pi-coding-agent": {"undici": "8.12.3"},
    "openai": {"undici": "$undici"}
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "typebox": "1.3.27",
    "undici": "7.30.1",
    "yaml": "2.9.0"
  }
}
