{
  "name": "starport-pi",
  "version": "0.4.0",
  "private": true,
  "description": "Pi workbench with isolated local and remote projects, managed egress and portable configuration",
  "type": "module",
  "license": "MIT",
  "bin": {
    "starport-pi": "bin/starport-pi.mjs"
  },
  "scripts": {
    "start": "node bin/starport-pi.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:server": "node scripts/test-server.mjs",
    "audit:source": "python3 scripts/audit_source.py",
    "build": "vite build",
    "panel": "node bin/starport-pi.mjs panel",
    "dev:web": "vite"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "overrides": {
    "@earendil-works/pi-coding-agent": {
      "undici": "8.12.3"
    },
    "openai": {
      "undici": "$undici"
    },
    "katex": "$katex"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "hash-wasm": "4.12.0",
    "jose": "6.2.14",
    "katex": "0.19.1",
    "opencc-js": "1.4.2",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "typebox": "1.3.27",
    "undici": "7.30.1",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "vite": "8.3.5"
  }
}
